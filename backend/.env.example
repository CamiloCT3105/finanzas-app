# Copia este archivo como .env y completa los valores.

PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_contrasena_de_postgres
DB_NAME=finanzas_app

# JWT: usa una cadena larga y aleatoria
JWT_SECRET=cambia_esta_cadena_por_una_larga_y_secreta
JWT_EXPIRES_IN=7d

# Zona horaria de la app (fechas, rachas y retos). Por defecto America/Bogota.
TZ=America/Bogota

# ---------------------------------------------------------------------------
# Producción / nube: en lugar de DB_HOST, DB_USER, etc. basta con DATABASE_URL
# (ej. la cadena de conexión de Neon). Si trae sslmode=require se usa SSL.
# DATABASE_URL=postgresql://usuario:contrasena@host/base?sslmode=require
# DB_SSL=true
# NODE_ENV=production
# Opcional: páginas web que pueden llamar la API, separadas por coma.
# CORS_ORIGIN=https://finanzas-app-web.onrender.com
